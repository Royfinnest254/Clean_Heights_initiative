# Clean Heights Initiative - Hardened Configuration
# Targeted for Namecheap / LiteSpeed / Apache

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect /index.html to /
    RewriteRule ^index\.html$ / [L,R=301]

    # 3. SPA Routing (Send all requests to index.html if file doesn't exist)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-l
    RewriteRule . /index.html [L]
</IfModule>

# 4. Security: Disable Directory Indexing (Fixes "Index of" issue)
Options -Indexes

# 5. Security: Block Access to Sensitive Files
<FilesMatch "(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|vite\.config\..*|\.gitignore|\.htaccess\.dist)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 6. Security: Prevent Image Hotlinking (Optional, can be removed if needed)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?cleanheightsinitiative\.org [NC]
# RewriteRule \.(jpg|jpeg|png|gif)$ - [F]

# 7. Security Headers
<IfModule mod_headers.c>
    # Protect against Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Protect against MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Protect against Cross-Site Scripting (XSS)
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (Basic starting point)
    # Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' https: data:;"
</IfModule>

# 8. Hide Server Information
ServerSignature Off

# 9. Cache policy: revalidate HTML so releases appear promptly; keep fingerprinted
# Vite bundles for a year. Mutable CMS media and PHP responses are never immutable.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, private"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|avif|woff2?)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/.+\.(js|css|woff2?)$" CHI_FINGERPRINTED_ASSET
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=CHI_FINGERPRINTED_ASSET
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
